#!/usr/bin/env bash
# =============================================================================
# /usr/local/bin/telcosec-prolabs — TelcoSec ProLabs Cyber Range Connector
#
# Provides seamless access to remote carrier testbeds, 5G SA pods, and
# virtual cyber range targets on https://app.telcosec.net/prolabs.
# =============================================================================
set -euo pipefail

PROLABS_DIR="/etc/telcosec/prolabs"
USER_PROLABS_DIR="${HOME}/.config/telcosec/prolabs"
PROLABS_URL="https://app.telcosec.net/prolabs"
VERSION="2026.1"

# Terminal Colors
if [ -t 1 ]; then
  BOLD='\033[1m'
  CYAN='\033[1;36m'
  GREEN='\033[1;32m'
  YELLOW='\033[1;33m'
  RED='\033[1;31m'
  BLUE='\033[1;34m'
  RESET='\033[0m'
else
  BOLD='' CYAN='' GREEN='' YELLOW='' RED='' BLUE='' RESET=''
fi

SHOW_HEADER() {
  echo -e "${CYAN}${BOLD}╔══════════════════════════════════════════════════════════════════╗${RESET}"
  echo -e "${CYAN}${BOLD}║              🧪 TelcoSec ProLabs — Cyber Range Connector         ║${RESET}"
  echo -e "${CYAN}${BOLD}║              Carrier Testbeds • 5G SA Pods • Cloud Targets       ║${RESET}"
  echo -e "${CYAN}${BOLD}╚══════════════════════════════════════════════════════════════════╝${RESET}\n"
}

SHOW_HELP() {
  SHOW_HEADER
  echo -e "Usage: ${BOLD}telcosec prolabs${RESET} [COMMAND] [OPTIONS]\n"
  echo -e "Commands:"
  echo -e "  ${GREEN}status${RESET}          Show active ProLabs VPN tunnels and testbed connectivity"
  echo -e "  ${GREEN}connect <id>${RESET}    Connect to a specific ProLabs testbed profile (e.g. 5g-sa-core)"
  echo -e "  ${GREEN}disconnect${RESET}      Tear down all active ProLabs cyber range tunnels"
  echo -e "  ${GREEN}list${RESET}            List available local and cloud cyber range profiles"
  echo -e "  ${GREEN}open${RESET}            Launch the ProLabs Web Console in your default browser"
  echo -e "  ${GREEN}help${RESET}            Show this help dialogue\n"
  echo -e "Web Portal: ${BLUE}${PROLABS_URL}${RESET}\n"
}

CMD="${1:-status}"

case "$CMD" in
  status)
    SHOW_HEADER
    echo -e "${BOLD}Current Cyber Range Connection Status:${RESET}"
    
    # Check for active WireGuard or OpenVPN ProLabs tunnels
    ACTIVE_TUNNEL=0
    if ip link show prolabs0 2>/dev/null | grep -q "UP"; then
      IP_ADDR=$(ip -4 addr show prolabs0 | grep -oP '(?<=inet\s)\d+(\.\d+){3}' || echo "Assigned")
      echo -e "  ${GREEN}● Connected to ProLabs WireGuard Range${RESET} (Interface: prolabs0 | IP: ${IP_ADDR})"
      ACTIVE_TUNNEL=1
    fi
    if ip link show tun-prolabs 2>/dev/null | grep -q "UP"; then
      IP_ADDR=$(ip -4 addr show tun-prolabs | grep -oP '(?<=inet\s)\d+(\.\d+){3}' || echo "Assigned")
      echo -e "  ${GREEN}● Connected to ProLabs OpenVPN Range${RESET} (Interface: tun-prolabs | IP: ${IP_ADDR})"
      ACTIVE_TUNNEL=1
    fi
    if ip link show wg0 2>/dev/null | grep -q "UP"; then
      IP_ADDR=$(ip -4 addr show wg0 | grep -oP '(?<=inet\s)\d+(\.\d+){3}' || echo "Assigned")
      echo -e "  ${YELLOW}● Active WireGuard Interface Detected${RESET} (Interface: wg0 | IP: ${IP_ADDR})"
      ACTIVE_TUNNEL=1
    fi
    
    if [ "$ACTIVE_TUNNEL" -eq 0 ]; then
      echo -e "  ${YELLOW}○ Disconnected${RESET} (No active ProLabs cyber range tunnel)"
      echo -e "\nTo connect to a target lab:"
      echo -e "  1. Download your VPN profile from ${BLUE}${PROLABS_URL}${RESET}"
      echo -e "  2. Run: ${BOLD}telcosec prolabs connect <profile-name>${RESET}"
    fi
    echo ""
    ;;

  open|portal|web)
    echo -e "Launching TelcoSec ProLabs Cyber Range Console in browser..."
    if command -v xdg-open >/dev/null 2>&1; then
      xdg-open "${PROLABS_URL}" 2>/dev/null &
    elif command -v firefox >/dev/null 2>&1; then
      firefox "${PROLABS_URL}" 2>/dev/null &
    else
      echo -e "Please visit: ${BLUE}${PROLABS_URL}${RESET}"
    fi
    ;;

  list)
    SHOW_HEADER
    echo -e "${BOLD}Available ProLabs Profiles:${RESET}"
    mkdir -p "${USER_PROLABS_DIR}" "${PROLABS_DIR}" 2>/dev/null || true
    
    PROFILES=$(find "${USER_PROLABS_DIR}" "${PROLABS_DIR}" -type f -name "*.conf" -o -name "*.ovpn" 2>/dev/null || true)
    if [ -n "$PROFILES" ]; then
      for f in $PROFILES; do
        bname=$(basename "$f")
        echo -e "  • ${GREEN}${bname%.*}${RESET} (${f})"
      done
    else
      echo -e "  ${YELLOW}No custom profiles saved yet in ~/.config/telcosec/prolabs/${RESET}"
      echo -e "  Standard Cloud Cyber Ranges:"
      echo -e "    1. ${GREEN}prolabs-5g-sa-core${RESET}        - 5G SA Core Security Assessment"
      echo -e "    2. ${GREEN}prolabs-lte-enb-security${RESET}  - LTE eNB & EPC Signaling Audit"
      echo -e "    3. ${GREEN}prolabs-baseband-research${RESET} - Remote Baseband QEMU Testbed"
      echo -e "    4. ${GREEN}prolabs-iot-sim-security${RESET}  - SIM/eSIM Remote OTA Intercept"
    fi
    echo ""
    ;;

  connect)
    PROFILE="${2:-}"
    if [ -z "$PROFILE" ]; then
      echo -e "${RED}ERROR: Please specify a profile name or file.${RESET}"
      echo -e "Usage: telcosec prolabs connect <profile-name>"
      exit 1
    fi
    
    TARGET_CONF=""
    if [ -f "$PROFILE" ]; then
      TARGET_CONF="$PROFILE"
    elif [ -f "${USER_PROLABS_DIR}/${PROFILE}.conf" ]; then
      TARGET_CONF="${USER_PROLABS_DIR}/${PROFILE}.conf"
    elif [ -f "${PROLABS_DIR}/${PROFILE}.conf" ]; then
      TARGET_CONF="${PROLABS_DIR}/${PROFILE}.conf"
    fi

    if [ -n "$TARGET_CONF" ]; then
      echo -e "--> Connecting to ProLabs profile: ${GREEN}${TARGET_CONF}${RESET}..."
      if command -v wg-quick >/dev/null 2>&1; then
        sudo wg-quick up "$TARGET_CONF"
        echo -e "${GREEN}✓ Successfully connected to ProLabs Cyber Range!${RESET}"
      fi
    else
      echo -e "${YELLOW}--> Launching ProLabs session for '${PROFILE}' via Cloud Console...${RESET}"
      xdg-open "${PROLABS_URL}/launch/${PROFILE}" 2>/dev/null || xdg-open "${PROLABS_URL}" 2>/dev/null || true
    fi
    ;;

  disconnect)
    echo -e "--> Tearing down active ProLabs cyber range tunnels..."
    sudo wg-quick down prolabs0 2>/dev/null || true
    sudo wg-quick down wg0 2>/dev/null || true
    sudo pkill -f "openvpn.*prolabs" 2>/dev/null || true
    echo -e "${GREEN}✓ ProLabs cyber range connections disconnected.${RESET}"
    ;;

  help|--help|-h)
    SHOW_HELP
    ;;

  *)
    echo -e "${RED}Unknown command: '$CMD'${RESET}"
    SHOW_HELP
    exit 1
    ;;
esac
