#!/usr/bin/env bash
# =============================================================================
# /usr/local/bin/telcosec-pkg — Official TelcoChisel Metapackage Manager
#
# Provides management of official TelcoChisel telecom security metapackages:
#   - List installed, available, and upgradable metapackages
#   - Install and remove metapackages by name or shorthand alias
#   - Inspect dependencies, recommends, and tool manifests
#   - Verify dependency integrity and repair broken states
#   - Manage official APT repository connection (meta.telcosec.net)
# =============================================================================
set -euo pipefail

VERSION="1.1.0"
TELCOSEC_URL="https://meta.telcosec.net"
TELCOSEC_KEY="/etc/apt/keyrings/telcochisel-archive-keyring.asc"
TELCOSEC_SOURCES="/etc/apt/sources.list.d/telcochisel.sources"
TELCOSEC_FPR="6326A34C15FEF05FBD63518B4325182E2F0D9DB9"

# Terminal styling
if [ -t 1 ]; then
  BOLD='\033[1m'
  CYAN='\033[1;36m'
  GREEN='\033[1;32m'
  YELLOW='\033[1;33m'
  RED='\033[1;31m'
  BLUE='\033[1;34m'
  MAGENTA='\033[1;35m'
  DIM='\033[2m'
  RESET='\033[0m'
else
  BOLD='' CYAN='' GREEN='' YELLOW='' RED='' BLUE='' MAGENTA='' DIM='' RESET=''
fi

# ── Canonical Metapackage Registry ──────────────────────────────────────────
# Order: base -> hardware -> protocol layers -> specialized -> full
METAPACKAGES=(
  "telcochisel-base"
  "telcochisel-hardware-sdr"
  "telcochisel-tools-sdr"
  "telcochisel-tools-2g-3g"
  "telcochisel-tools-4g"
  "telcochisel-tools-5g"
  "telcochisel-tools-sim"
  "telcochisel-tools-pstn-adsl"
  "telcochisel-tools-ue"
  "telcochisel-meta-full"
)

get_pkg_alias() {
  case "$1" in
    telcochisel-base)             echo "base" ;;
    telcochisel-hardware-sdr)     echo "hardware" ;;
    telcochisel-tools-sdr)         echo "sdr" ;;
    telcochisel-tools-2g-3g)       echo "2g-3g" ;;
    telcochisel-tools-4g)          echo "4g" ;;
    telcochisel-tools-5g)          echo "5g" ;;
    telcochisel-tools-sim)         echo "sim" ;;
    telcochisel-tools-pstn-adsl)   echo "wireline" ;;
    telcochisel-tools-ue)          echo "ue" ;;
    telcochisel-meta-full)         echo "full" ;;
    *)                             echo "unknown" ;;
  esac
}

get_pkg_desc() {
  case "$1" in
    telcochisel-base)             echo "Core OS kernel latency tuning, PAM limits & realtime groups" ;;
    telcochisel-hardware-sdr)     echo "SDR USB udev rules & FPGA bitstream loaders (BladeRF, USRP, Lime)" ;;
    telcochisel-tools-sdr)         echo "RF analysis suite (GNU Radio, Gqrx, inspectrum, URH, SigMF)" ;;
    telcochisel-tools-2g-3g)       echo "Cellular 2G/3G Osmocom infrastructure, YateBTS & gr-gsm" ;;
    telcochisel-tools-4g)          echo "4G LTE eNodeB/EPC simulation & protocol audit (srsRAN, Open5GS)" ;;
    telcochisel-tools-5g)          echo "5G SA Core (Open5GS), gNodeB & 5Ghoul fuzzer over rogue gNB" ;;
    telcochisel-tools-sim)         echo "SIM & eSIM auditing suite (pySim-shell, SIMtrace 2, lpac, SIMurai)" ;;
    telcochisel-tools-pstn-adsl)   echo "PSTN/ISDN signaling, Asterisk, SIPp, VoIP & ADSL broadband testing" ;;
    telcochisel-tools-ue)          echo "Mobile User Equipment & baseband diagnostics (UERANSIM, SCAT, QCSuper)" ;;
    telcochisel-meta-full)         echo "Complete TelcoChisel telecom security distribution umbrella" ;;
    *)                             echo "Custom or third-party metapackage" ;;
  esac
}

resolve_alias() {
  local input="$1"
  case "$input" in
    base|system)                                  echo "telcochisel-base" ;;
    hw|hardware|sdr-hw|firmware)                  echo "telcochisel-hardware-sdr" ;;
    sdr|rf|spectrum)                              echo "telcochisel-tools-sdr" ;;
    2g|3g|gsm|osmocom)                            echo "telcochisel-tools-2g-3g" ;;
    4g|lte|enodeb)                                echo "telcochisel-tools-4g" ;;
    5g|nr|sa|5ghoul)                              echo "telcochisel-tools-5g" ;;
    sim|esim|uicc|card)                           echo "telcochisel-tools-sim" ;;
    pstn|adsl|vdsl|wireline|voip|sip|asterisk)    echo "telcochisel-tools-pstn-adsl" ;;
    ue|mobile|ueransim|baseband)                  echo "telcochisel-tools-ue" ;;
    full|all|meta-full|everything)                echo "telcochisel-meta-full" ;;
    telcochisel-*)                                echo "$input" ;;
    *)                                            echo "telcochisel-${input}" ;;
  esac
}

banner() {
  printf "${CYAN}"
  cat << 'EOF'
  _____ _____ _     ____ ___   ____ _   _ ___ ____  _____ _     
 |_   _| ____| |   / ___/ _ \ / ___| | | |_ _/ ___|| ____| |    
   | | |  _| | |  | |  | | | | |   | |_| || |\___ \|  _| | |    
   | | | |___| |__| |__| |_| | |___|  _  || | ___) | |___| |___ 
   |_| |_____|_____\____\___/ \____|_| |_|___|____/|_____|_____|
EOF
  printf "${RESET}${BOLD}        TelcoChisel Metapackage Manager (telcosec-pkg) v%s${RESET}\n\n" "$VERSION"
}

usage() {
  banner
  cat << EOF
Usage: telcosec-pkg <command> [options]
       telcochisel-pkg <command> [options]

Commands:
  list [--json]              List status of all official TelcoChisel metapackages
  install <pkg|alias...>     Install one or more metapackages with recommendations
  remove <pkg|alias...>      Remove one or more metapackages (-a/--autoremove supported)
  purge <pkg|alias...>       Purge metapackages and configuration files
  info <pkg|alias>           Show detailed package metadata, dependencies and tools
  check | verify             Audit health of installed metapackages and dependencies
  repo [status|enable]       Check or configure official APT repo (meta.telcosec.net)
  version                    Display version and APT repository status

Shorthand Aliases:
  base, hardware, sdr, 2g-3g, 4g, 5g, sim, wireline, ue, full

Examples:
  telcosec-pkg list
  telcosec-pkg install 5g ue
  telcosec-pkg install wireline
  telcosec-pkg info sdr
  telcosec-pkg check
  telcosec-pkg remove 2g-3g --autoremove
EOF
}

require_root() {
  if [ "$(id -u)" -ne 0 ]; then
    if command -v sudo >/dev/null 2>&1; then
      SUDO="sudo"
    else
      echo -e "${RED}Error: Root privileges required for package management.${RESET}" >&2
      exit 1
    fi
  else
    SUDO=""
  fi
}

# ── Package Status Probe ────────────────────────────────────────────────────
# Returns: "installed", "upgradable", "not-installed"
get_package_status() {
  local pkg="$1"
  local inst_ver cand_ver

  if ! command -v dpkg-query >/dev/null 2>&1; then
    echo "not-installed"
    return 0
  fi

  inst_ver=$(dpkg-query -W -f='${Version}' "$pkg" 2>/dev/null || echo "")
  if [ -z "$inst_ver" ]; then
    echo "not-installed"
    return 0
  fi

  if ! command -v apt-cache >/dev/null 2>&1; then
    echo "installed"
    return 0
  fi

  cand_ver=$(apt-cache policy "$pkg" 2>/dev/null | awk '/Candidate:/ {print $2}')
  if [ -n "$cand_ver" ] && [ "$cand_ver" != "(none)" ] && [ "$cand_ver" != "$inst_ver" ]; then
    echo "upgradable"
  else
    echo "installed"
  fi
}

cmd_list() {
  local json_mode=0
  if [[ "${1:-}" == "--json" ]]; then
    json_mode=1
  fi

  if [ "$json_mode" -eq 0 ]; then
    banner
    echo -e "${BOLD}Official TelcoChisel Metapackages Status:${RESET}\n"
    printf "  ${BOLD}%-28s %-10s %-14s %-12s %s${RESET}\n" "PACKAGE" "ALIAS" "STATUS" "VERSION" "DESCRIPTION"
    printf "  %-28s %-10s %-14s %-12s %s\n" "----------------------------" "----------" "--------------" "------------" "----------------------------------------"
  fi

  local installed_count=0
  local total_count=${#METAPACKAGES[@]}
  local json_items=()
  local has_dpkg=0 has_apt=0
  command -v dpkg-query >/dev/null 2>&1 && has_dpkg=1
  command -v apt-cache >/dev/null 2>&1 && has_apt=1

  for pkg in "${METAPACKAGES[@]}"; do
    local alias desc status_code status_label ver_str cand_ver
    alias=$(get_pkg_alias "$pkg")
    desc=$(get_pkg_desc "$pkg")
    status_code=$(get_package_status "$pkg")
    ver_str="-"
    cand_ver="-"
    if [ "$has_dpkg" -eq 1 ] && [ "$status_code" != "not-installed" ]; then
      ver_str=$(dpkg-query -W -f='${Version}' "$pkg" 2>/dev/null || echo "-")
    fi
    if [ "$has_apt" -eq 1 ]; then
      cand_ver=$(apt-cache policy "$pkg" 2>/dev/null | awk '/Candidate:/ {print $2}' || echo "-")
    fi

    case "$status_code" in
      installed)
        status_label="${GREEN}[INSTALLED]${RESET}"
        ((installed_count++))
        ;;
      upgradable)
        status_label="${CYAN}[UPGRADABLE]${RESET}"
        ((installed_count++))
        ;;
      not-installed)
        status_label="${YELLOW}[AVAILABLE]${RESET}"
        ;;
    esac

    if [ "$json_mode" -eq 0 ]; then
      printf "  %-28s %-10s %-24b %-12s %s\n" "$pkg" "$alias" "$status_label" "$ver_str" "$desc"
    else
      json_items+=("{\"package\":\"$pkg\",\"alias\":\"$alias\",\"status\":\"$status_code\",\"installed_version\":\"$ver_str\",\"candidate_version\":\"$cand_ver\",\"description\":\"$desc\"}")
    fi
  done

  if [ "$json_mode" -eq 0 ]; then
    echo ""
    echo -e "  Installed Metapackages: ${BOLD}${installed_count} / ${total_count}${RESET}"
    if [ "$installed_count" -eq "$total_count" ]; then
      echo -e "  Suite Coverage        : ${GREEN}Full Operational Suite Active${RESET}"
    elif [ "$installed_count" -gt 0 ]; then
      echo -e "  Suite Coverage        : ${CYAN}Modular Profile (${installed_count} packages active)${RESET}"
    else
      echo -e "  Suite Coverage        : ${YELLOW}Base Image (Metapackages available for installation)${RESET}"
    fi
    echo -e "\n  ${DIM}Install a package with:${RESET} ${BOLD}telcosec-pkg install <alias>${RESET}"
  else
    printf "[\n  %s\n]\n" "$(IFS=,; echo "${json_items[*]}")"
  fi
}

cmd_install() {
  if [ "$#" -eq 0 ]; then
    echo -e "${RED}Error: Specify at least one metapackage or alias to install.${RESET}"
    echo "Example: telcosec-pkg install 5g ue"
    exit 1
  fi

  require_root

  # Resolve all inputs to actual deb package names
  local pkgs_to_install=()
  for arg in "$@"; do
    [ "$arg" = "-y" ] && continue
    pkgs_to_install+=("$(resolve_alias "$arg")")
  done

  echo -e "${BOLD}Target Metapackages:${RESET} ${CYAN}${pkgs_to_install[*]}${RESET}"

  # Verify APT repository is available
  if [ ! -f "$TELCOSEC_SOURCES" ]; then
    echo -e "${YELLOW}Notice: TelcoChisel APT source not found in ${TELCOSEC_SOURCES}.${RESET}"
    echo "Configuring official repository from ${TELCOSEC_URL}..."
    cmd_repo enable
  fi

  echo -e "\n${BOLD}Updating package indexes...${RESET}"
  $SUDO apt-get update -o Dir::Etc::sourcelist="sources.list.d/telcochisel.sources" 2>/dev/null || $SUDO apt-get update

  echo -e "\n${BOLD}Installing packages with recommended telecom tools...${RESET}"
  $SUDO apt-get install -y --install-recommends -o Dpkg::Options::="--force-overwrite" "${pkgs_to_install[@]}"

  echo -e "\n${GREEN}✓ Metapackage installation completed successfully.${RESET}"
}

cmd_remove() {
  if [ "$#" -eq 0 ]; then
    echo -e "${RED}Error: Specify at least one metapackage or alias to remove.${RESET}"
    exit 1
  fi

  require_root

  local autoremove=0
  local pkgs_to_remove=()

  for arg in "$@"; do
    case "$arg" in
      -a|--autoremove) autoremove=1 ;;
      *) pkgs_to_remove+=("$(resolve_alias "$arg")") ;;
    esac
  done

  echo -e "${BOLD}Removing Metapackages:${RESET} ${YELLOW}${pkgs_to_remove[*]}${RESET}"
  $SUDO apt-get remove -y "${pkgs_to_remove[@]}"

  if [ "$autoremove" -eq 1 ]; then
    echo -e "\n${BOLD}Cleaning orphaned dependencies (--autoremove)...${RESET}"
    $SUDO apt-get autoremove -y
  fi

  echo -e "\n${GREEN}✓ Metapackage removal complete.${RESET}"
}

cmd_purge() {
  if [ "$#" -eq 0 ]; then
    echo -e "${RED}Error: Specify at least one metapackage or alias to purge.${RESET}"
    exit 1
  fi

  require_root

  local pkgs_to_purge=()
  for arg in "$@"; do
    pkgs_to_purge+=("$(resolve_alias "$arg")")
  done

  echo -e "${BOLD}Purging Metapackages and configs:${RESET} ${RED}${pkgs_to_purge[*]}${RESET}"
  $SUDO apt-get purge -y "${pkgs_to_purge[@]}"
  echo -e "\n${GREEN}✓ Metapackage purge complete.${RESET}"
}

cmd_info() {
  if [ "$#" -eq 0 ]; then
    echo -e "${RED}Error: Specify a metapackage or alias to inspect.${RESET}"
    exit 1
  fi

  local target
  target=$(resolve_alias "$1")

  banner
  echo -e "${BOLD}Metapackage Details: ${CYAN}${target}${RESET}\n"

  if dpkg -s "$target" >/dev/null 2>&1; then
    echo -e "  Status        : ${GREEN}[INSTALLED]${RESET}"
    dpkg -s "$target" | grep -E '^(Version|Architecture|Installed-Size|Depends|Recommends|Suggests|Description):' | sed 's/^/  /'
  elif apt-cache show "$target" >/dev/null 2>&1; then
    echo -e "  Status        : ${YELLOW}[AVAILABLE IN REPOSITORY]${RESET}"
    apt-cache show "$target" | head -n 25 | grep -E '^(Package|Version|Architecture|Installed-Size|Depends|Recommends|Suggests|Description):' | sed 's/^/  /'
  else
    echo -e "${YELLOW}Package '${target}' not found in local dpkg database or configured APT repositories.${RESET}"
    echo -e "Run 'telcosec-pkg repo status' to check your repository configuration."
  fi
  echo ""
}

cmd_check() {
  banner
  echo -e "${BOLD}=== TelcoChisel Metapackage & Dependency Audit ===${RESET}\n"

  local broken=0
  local verified=0

  # 1. dpkg database audit
  echo -e "Checking dpkg package database integrity..."
  if dpkg -C >/dev/null 2>&1; then
    echo -e "  ${GREEN}✓ dpkg database is clean (no half-configured packages)${RESET}"
  else
    echo -e "  ${RED}✗ dpkg reported half-configured or damaged packages${RESET}"
    ((broken++))
  fi

  # 2. apt-get check
  echo -e "Checking APT dependency tree..."
  if apt-get check >/dev/null 2>&1; then
    echo -e "  ${GREEN}✓ Dependency tree is consistent (no unmet dependencies)${RESET}"
  else
    echo -e "  ${RED}✗ Unmet dependencies detected${RESET}"
    ((broken++))
  fi

  # 3. Audit each installed metapackage
  echo -e "\nAuditing installed TelcoChisel metapackages:"
  for pkg in "${METAPACKAGES[@]}"; do
    if dpkg-query -W -f='${Status}' "$pkg" 2>/dev/null | grep -q "install ok installed"; then
      local ver
      ver=$(dpkg-query -W -f='${Version}' "$pkg")
      echo -e "  ${GREEN}✓${RESET} ${BOLD}${pkg}${RESET} (v${ver}): Healthy"
      ((verified++))
    fi
  done

  echo ""
  if [ "$verified" -eq 0 ]; then
    echo -e "  ${YELLOW}Notice: No official TelcoChisel metapackages are currently tracked by dpkg.${RESET}"
    echo -e "  Install the base or full suite with: ${BOLD}telcosec-pkg install full${RESET}"
  elif [ "$broken" -eq 0 ]; then
    echo -e "  ${GREEN}Audit Result: All ${verified} installed metapackages are healthy and satisfied.${RESET}"
  else
    echo -e "  ${RED}Audit Result: Detected ${broken} dependency issues.${RESET}"
    echo -e "  Remediation: Run ${BOLD}sudo apt-get --fix-broken install -y${RESET}"
  fi
}

cmd_repo() {
  local action="${1:-status}"

  case "$action" in
    status)
      banner
      echo -e "${BOLD}=== TelcoChisel Official APT Repository Status ===${RESET}\n"
      echo -e "  Repository URL   : ${CYAN}${TELCOSEC_URL}${RESET}"
      echo -e "  Sources File     : ${TELCOSEC_SOURCES}"
      echo -e "  Keyring Path     : ${TELCOSEC_KEY}"
      echo -e "  Expected Fingerprint : ${TELCOSEC_FPR}"

      if [ -f "$TELCOSEC_SOURCES" ]; then
        echo -e "  Sources List     : ${GREEN}Active${RESET}"
      else
        echo -e "  Sources List     : ${RED}Missing${RESET}"
      fi

      if [ -s "$TELCOSEC_KEY" ]; then
        echo -e "  GPG Keyring      : ${GREEN}Present${RESET}"
        local actual_fpr
        actual_fpr=$(gpg --show-keys --with-colons "$TELCOSEC_KEY" 2>&1 | awk -F: '$1=="fpr"{print $10; exit}' || echo "none")
        if [ "$actual_fpr" = "$TELCOSEC_FPR" ]; then
          echo -e "  Key Verification : ${GREEN}Valid (Fingerprint verified)${RESET}"
        else
          echo -e "  Key Verification : ${YELLOW}Fingerprint mismatch ($actual_fpr)${RESET}"
        fi
      else
        echo -e "  GPG Keyring      : ${RED}Missing${RESET}"
      fi
      ;;

    enable)
      require_root
      echo -e "Configuring official TelcoChisel APT repository (${TELCOSEC_URL})..."
      $SUDO mkdir -p /etc/apt/keyrings /etc/apt/sources.list.d

      if curl -fsSL "${TELCOSEC_URL}/public.gpg" -o "$TELCOSEC_KEY" 2>/dev/null && [ -s "$TELCOSEC_KEY" ]; then
        $SUDO chmod 0644 "$TELCOSEC_KEY"
        cat << 'EOF' | $SUDO tee "$TELCOSEC_SOURCES" >/dev/null
Types: deb
URIs: https://meta.telcosec.net
Suites: noble
Components: main
Signed-By: /etc/apt/keyrings/telcochisel-archive-keyring.asc
EOF
        echo -e "${GREEN}✓ TelcoChisel repository enabled and pinned.${RESET}"
      else
        echo -e "${RED}Error: Failed to fetch signing key from ${TELCOSEC_URL}/public.gpg${RESET}" >&2
        exit 1
      fi
      ;;

    refresh)
      require_root
      echo -e "Refreshing TelcoChisel repository metadata..."
      $SUDO apt-get update -o Dir::Etc::sourcelist="sources.list.d/telcochisel.sources"
      echo -e "${GREEN}✓ Package index refreshed.${RESET}"
      ;;

    *)
      echo -e "${RED}Unknown repo action: $action${RESET}"
      echo "Valid actions: status, enable, refresh"
      exit 1
      ;;
  esac
}

# ── Main Entrypoint ─────────────────────────────────────────────────────────
COMMAND="${1:-list}"
shift 2>/dev/null || true

case "$COMMAND" in
  list)
    cmd_list "$@"
    ;;
  install|add)
    cmd_install "$@"
    ;;
  remove|uninstall|del|rm)
    cmd_remove "$@"
    ;;
  purge)
    cmd_purge "$@"
    ;;
  info|show|desc)
    cmd_info "$@"
    ;;
  check|verify|audit)
    cmd_check "$@"
    ;;
  repo|repository)
    cmd_repo "$@"
    ;;
  version|-v|--version)
    echo "telcosec-pkg v${VERSION} (TelcoChiselOS Metapackage Manager)"
    ;;
  help|-h|--help)
    usage
    ;;
  *)
    echo -e "${RED}Unknown command: $COMMAND${RESET}\n"
    usage
    exit 1
    ;;
esac
