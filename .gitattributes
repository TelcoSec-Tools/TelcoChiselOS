# Set default behavior to automatically normalize line endings
* text=auto eol=lf

# Force shell scripts, configs, and source files to LF
*.sh text eol=lf
*.py text eol=lf
*.js text eol=lf
*.ts text eol=lf
*.vue text eol=lf
*.json text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.desktop text eol=lf
*.conf text eol=lf
*.rules text eol=lf
*.service text eol=lf
*.list text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.css text eol=lf
*.html text eol=lf
*.directory text eol=lf
*.menu text eol=lf
*.ini text eol=lf
*.lua text eol=lf

# Binary files
*.iso binary
*.deb binary
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.tar.gz binary
*.tgz binary
*.zip binary
